generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  OTOMOBIL
  ARAZI_SUV
  MOTOSIKLET
  MINIVAN
  TICARI
}

enum SentimentType {
  COMPLAINT
  POSITIVE
  TIP
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  image        String?
  ownedCar     String?
  createdAt    DateTime  @default(now())
  posts        Post[]
  comments     Comment[]
  votes        Vote[]
}

model Post {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  category      Category
  brand         String
  model         String
  year          Int
  fuelType      String
  kmUsed        String
  usagePeriod   String
  sentimentType SentimentType
  isChronik     Boolean       @default(false)
  title         String
  body          String        @db.Text
  tags          String[]
  thumbsUp      Int           @default(0)
  thumbsDown    Int           @default(0)
  viewCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  comments      Comment[]
  votes         Vote[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Vote {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])
  type   String

  @@unique([postId, userId])
}

model Review {
  id              String   @id
  kategoriSlug    String
  kullanici       String
  kullaniciAvatar String?
  verified        Boolean  @default(false)
  marka           String
  model           String
  kasaKod         String?
  kasaTip         String?
  yil             Int?
  puan            Float
  sinifKodu       String?
  baslik          String
  icerik          String   @db.Text
  olumlu          String[]
  olumsuz         String[]
  sentimentType   String?
  kaynakUrl       String?
  tarih           String?
  izlenme         Int?
  likeCount       Int?
  createdAt       DateTime @default(now())

  @@index([marka, model])
  @@index([kategoriSlug])
  @@index([izlenme(sort: Desc)])
}

// 2. el araç ilanlarından toplanan fiyat verisi.
// EUR cinsinden saklanır, TL gösterim için lib/currency.ts üzerinden çevrilir.
model VehiclePrice {
  id        String   @id @default(cuid())
  marka     String
  model     String
  yil       Int
  km        Int?
  fiyatEur  Float
  motor     String?
  gucHp     Int?
  vites     String?
  yakit     String?
  kasa      String?
  renk      String?
  sehir     String?
  ulke      String
  kaynak    String   // "mobile.de" | "arabam.com" | ...
  ilanUrl   String?  @unique
  ilanTarih String?
  tarih     DateTime @default(now())

  @@index([marka, model, yil])
  @@index([kaynak])
}
